// All UI state lives in globals so Rust can drive every page without reaching
// into nested components. Callbacks are ids/values only; logic stays in Rust.

import {
    AgendaItem, RevisionItem, ExamCard, SubjectRow, ChapterRow, SessionRow,
    SlotRow, TemplateRow, WeekDay, BarPoint, SubjectSliceData, StatusSlice,
    MockRowData, MistakeRowData, SleepItem, HeatCell, PreviewData, PlanRowData,
    WizardSubjectRow, WizardChapterRow, WizardExamRow, WizardSlotRow,
    BuilderSubjectRow, BuilderExamRow
} from "models.slint";

export global Shell {
    in-out property <int> current-page: 0;
    in-out property <string> page-title: "Overview";
    in-out property <string> page-context: "";
    in-out property <string> plan-name: "";
    in-out property <string> plan-id: "";
    in-out property <string> plan-span: "";
    in-out property <[string]> plan-names: [];
    in-out property <int> plan-index: 0;
    in-out property <string> toast-text: "";
    // 0 info, 1 success, 2 error
    in-out property <int> toast-tone: 0;
    in-out property <bool> toast-open: false;
    in-out property <string> status-text: "Local only · SQLite";
    in-out property <string> today-text: "";
    in-out property <bool> exam-mode: false;
    in-out property <int> revision-badge: 0;
    in-out property <string> version: "0.1.0";
    in-out property <[string]> nav-labels: ["Overview", "Timetable", "Syllabus", "Focus", "Revision Queue", "Exams", "Analytics", "Import / Export", "Settings"];
    callback navigate(int);
    callback plan-selected(int);
    callback open-new-plan();
    callback quick-focus();
    callback dismiss-toast();
}

