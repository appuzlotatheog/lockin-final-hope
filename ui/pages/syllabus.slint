// Syllabus: subjects, chapter checklists, confidence, notes and revision hooks.

import { Palette, Metrics } from "../theme.slint";
import {
    AppButton, Card, Divider, Pill, ProgressBar, SectionTitle, EmptyState,
    Field, LabeledCombo, Modal, Toggle, TextArea
} from "../components.slint";
import { SyllabusData } from "../state.slint";
import { ScrollView } from "std-widgets.slint";

export component SyllabusPage inherits Rectangle {
    background: transparent;

    VerticalLayout {
        padding: Metrics.page-pad;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            SectionTitle {
                title: "Syllabus tracker";
                subtitle: SyllabusData.all-count + " chapters · " + SyllabusData.ready-count + " exam ready";
                horizontal-stretch: 1; }
            Field {
                label: "";
                text <=> SyllabusData.search;
                placeholder: "Search chapters…";
                min-width: 210px;
                max-width: 240px;
            }
            LabeledCombo {
                label: "";
                model: SyllabusData.filter-names;
                current-index: SyllabusData.filter;
                selected(index) => { SyllabusData.set-filter(index); }
                min-width: 150px;
                max-width: 170px;
            }
            AppButton { text: "Add chapter"; kind: 0; button-width: 96px; clicked => { SyllabusData.open-add-chapter(); } }
        }

        HorizontalLayout {
            spacing: 12px;

            Card {
                min-width: 252px;
                max-width: 252px;
                VerticalLayout {
                    padding: 10px;
                    spacing: 3px;
                    Text { text: "SUBJECTS"; color: Palette.muted; font-size: 9px; font-weight: 700; letter-spacing: 1px; }
                    Rectangle { height: 4px; }
                    for subject[i] in SyllabusData.subjects: Rectangle {
                        height: 52px;
                        border-radius: Metrics.radius-sm;
                        background: SyllabusData.subject-index == i ? Palette.accent-soft : (subject-touch.has-hover ? #ffffff06 : transparent);
                        subject-touch := TouchArea { mouse-cursor: pointer; clicked => { SyllabusData.select-subject(i); } }
                        Rectangle { x: 0; y: 8px; width: 3px; height: 36px; border-radius: 2px; background: subject.tint; }
                        VerticalLayout {
                            x: 12px; y: 0; width: parent.width - 76px; height: parent.height;
                            spacing: 2px; alignment: center;
                            Text { text: subject.name; color: Palette.text; font-size: 12px; font-weight: 600; overflow: elide; }
                            Text { text: subject.ready-count + " / " + subject.chapter-count + " ready"; color: Palette.muted; font-size: 9.5px; }
                        }
                        Text {
                            x: parent.width - 62px; y: 0; width: 50px; height: parent.height;
                            text: subject.progress + "%"; color: subject.progress >= 80 ? Palette.success : Palette.muted;
                            font-size: 10.5px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center;
                        }
                    }
                }
            }

            Card {
                horizontal-stretch: 1;
                VerticalLayout {
                    padding: 14px;
                    spacing: 6px;
                    HorizontalLayout {
                        SectionTitle { title: "Chapters"; subtitle: "Click a chapter to update its checklist and confidence"; horizontal-stretch: 1; }
                    }
                    Divider { }
                    if SyllabusData.chapters.length == 0: VerticalLayout {
                        padding-top: 30px; padding-bottom: 30px;
                        EmptyState { title: "No chapters here"; body: "Select another subject or add a chapter to start tracking portions."; }
                    }
                    for chapter[i] in SyllabusData.chapters: Rectangle {
                        height: 58px;
                        border-radius: Metrics.radius-sm;
                        background: chapter-touch.has-hover ? #ffffff06 : transparent;
                        chapter-touch := TouchArea { mouse-cursor: pointer; clicked => { SyllabusData.select-chapter(chapter.id); } }
                        Rectangle { x: 0; y: 10px; width: 3px; height: 38px; border-radius: 2px; background: chapter.tint; }
                        VerticalLayout {
                            x: 12px; y: 0; width: parent.width - 230px; height: parent.height;
                            spacing: 2px; alignment: center;
                            Text { text: chapter.title; color: Palette.text; font-size: 12px; font-weight: 600; overflow: elide; }
                            Text { text: chapter.subject + " · checklist " + chapter.checklist-done + "/4 · confidence " + (chapter.confidence == 0 ? "—" : chapter.confidence) + "/5"; color: Palette.muted; font-size: 9.5px; }
                        }
                        Text {
                            x: parent.width - 214px; y: 0; width: 74px; height: parent.height;
                            text: chapter.study-text; color: Palette.muted; font-size: 10px;
                            horizontal-alignment: right; vertical-alignment: center;
                        }
                        Pill {
                            x: parent.width - 132px; y: (parent.height - 21px) / 2;
                            text: chapter.status;
                            tone: chapter.status-index == 4 ? 2 : chapter.status-index == 3 ? 3 : chapter.status-index == 2 ? 4 : chapter.status-index == 1 ? 1 : 0;
                        }
                    }
                }
            }
        }
    }

    Modal {
        open: SyllabusData.detail-open;
        title: SyllabusData.detail-title;
        subtitle: SyllabusData.detail-subject;
        dialog-width: 660px;
        dialog-height: 620px;
        close => { SyllabusData.close-detail(); }
        ScrollView {
            vertical-stretch: 1;
            content-width: self.width;
            VerticalLayout {
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    LabeledCombo {
                        label: "Status"; model: SyllabusData.status-names;
                        current-index: SyllabusData.detail-status;
                        selected(index) => { SyllabusData.set-status(index); }
                        horizontal-stretch: 1;
                    }
                    LabeledCombo {
                        label: "Confidence"; model: SyllabusData.confidence-names;
                        current-index: SyllabusData.confidence;
                        selected(index) => { SyllabusData.set-confidence(index); }
                        horizontal-stretch: 1;
                    }
                }
                Text { text: "Chapter checklist · toggle each part"; color: Palette.muted; font-size: 10px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    Toggle { label: "Concept"; checked: SyllabusData.concept; toggled(v) => { SyllabusData.toggle-check(0); } horizontal-stretch: 1; }
                    Toggle { label: "Textbook"; checked: SyllabusData.textbook; toggled(v) => { SyllabusData.toggle-check(1); } horizontal-stretch: 1; }
                    Toggle { label: "Exercises"; checked: SyllabusData.exercises; toggled(v) => { SyllabusData.toggle-check(2); } horizontal-stretch: 1; }
                    Toggle { label: "Self test"; checked: SyllabusData.selftest; toggled(v) => { SyllabusData.toggle-check(3); } horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Accuracy " + SyllabusData.accuracy-text; color: Palette.text; font-size: 12px; font-weight: 600; vertical-alignment: center; }
                    Text { text: "Study " + SyllabusData.study-text; color: Palette.muted; font-size: 11px; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    Field { label: ""; text <=> SyllabusData.questions; placeholder: "Questions"; min-width: 88px; max-width: 96px; }
                    Field { label: ""; text <=> SyllabusData.correct; placeholder: "Correct"; min-width: 88px; max-width: 96px; }
                    AppButton { text: "Save marks"; kind: 1; button-width: 90px; button-height: 32px; clicked => { SyllabusData.save-metrics(SyllabusData.questions, SyllabusData.correct); } }
                }
                Text { text: "Last studied " + SyllabusData.last-studied + " · next revision " + SyllabusData.next-revision; color: Palette.muted; font-size: 10.5px; }
                TextArea { text <=> SyllabusData.notes; placeholder: "Notes, traps, formulas to remember…"; area-height: 150px; family: Palette.sans; }
                Text { text: "Revision hooks"; color: Palette.muted; font-size: 10px; font-weight: 700; }
                HorizontalLayout {
                    spacing: 8px;
                    AppButton { text: "Generate 1/3/7 revisions"; kind: 1; button-width: 168px; clicked => { SyllabusData.generate-revisions(); } }
                    AppButton { text: "Save notes"; kind: 0; button-width: 92px; clicked => { SyllabusData.save-notes(SyllabusData.notes); } }
                    Rectangle { horizontal-stretch: 1; }
                    AppButton { text: "Delete chapter"; kind: 3; button-width: 106px; clicked => { SyllabusData.delete-chapter(SyllabusData.detail-id); } }
                }
            }
        }
    }

    Modal {
        open: SyllabusData.add-chapter-open;
        title: "Add chapter";
        subtitle: "Chapters are local to the selected subject.";
        dialog-width: 460px;
        dialog-height: 300px;
        close => { SyllabusData.close-add-chapter(); }
        VerticalLayout {
            spacing: 10px;
            Field { label: "Chapter title"; text <=> SyllabusData.new-chapter-title; placeholder: "e.g. Mechanical properties of fluids"; }
            Rectangle { vertical-stretch: 1; }
            HorizontalLayout {
                spacing: 8px;
                AppButton { text: "Cancel"; kind: 1; stretch: true; clicked => { SyllabusData.close-add-chapter(); } }
                AppButton { text: "Add chapter"; kind: 0; stretch: true; clicked => { SyllabusData.add-chapter(SyllabusData.new-chapter-title); } }
            }
        }
    }
}
