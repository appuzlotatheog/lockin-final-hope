{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lockin.local/schemas/lockin-plan.schema.json",
  "title": "Lockin Plan Format",
  "description": "Versioned, human-editable study plan format for lockin-final-hope. See PLAN_FORMAT.md.",
  "type": "object",
  "required": ["format", "schema_version", "plan"],
  "additionalProperties": true,
  "properties": {
    "format": {
      "const": "lockin-plan",
      "description": "Format identifier. Must be exactly 'lockin-plan'."
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "description": "Currently 1. Newer versions are rejected by the app."
    },
    "plan": {
      "type": "object",
      "required": ["id", "name", "start_date", "end_date"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "timezone": { "type": "string", "default": "Asia/Kolkata" },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date": { "$ref": "#/$defs/date" },
        "academic_year": { "type": "string" }
      }
    },
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$" },
          "sort_order": { "type": "integer" },
          "chapters": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "title"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "title": { "type": "string", "minLength": 1 },
                "order": { "type": "integer" },
                "status": {
                  "enum": ["not_started", "learning", "needs_practice", "needs_revision", "exam_ready"]
                }
              }
            }
          }
        }
      }
    },
    "exams": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "subject_id", "label", "date", "start_time"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "subject_id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "date": { "$ref": "#/$defs/date" },
          "start_time": { "$ref": "#/$defs/time" },
          "session": { "type": "string" }
        }
      }
    },
    "schedule_templates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "day_types", "slots"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "day_types": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["weekday", "saturday", "sunday", "holiday", "custom"] }
          },
          "slots": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "start_time", "end_time", "type", "title"],
              "additionalProperties": true,
              "properties": {
                "id": { "type": "string", "minLength": 1 },
                "start_time": { "$ref": "#/$defs/time" },
                "end_time": { "$ref": "#/$defs/time" },
                "type": { "enum": ["study", "break", "meal"] },
                "title": { "type": "string" },
                "subject_id": { "type": "string" },
                "chapter_id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "date", "title", "task_type", "start_time", "end_time"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "date": { "$ref": "#/$defs/date" },
          "title": { "type": "string", "minLength": 1 },
          "task_type": { "enum": ["study", "revision", "mock_test", "backlog"] },
          "subject_id": { "type": "string" },
          "chapter_id": { "type": "string" },
          "start_time": { "$ref": "#/$defs/time" },
          "end_time": { "$ref": "#/$defs/time" },
          "estimated_minutes": { "type": "integer", "minimum": 1 },
          "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
          "status": {
            "enum": ["planned", "in_progress", "completed", "partially_completed", "skipped"]
          }
        }
      }
    },
    "revision_policy": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "interval_days": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 },
          "default": [1, 3, 7]
        },
        "adapt_to_results": { "type": "boolean", "default": true }
      }
    }
  },
  "$defs": {
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "time": {
      "type": "string",
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
    }
  }
}
